# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required by every /api/v1/* request (header: X-API-Key).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY="change-me"

# Optional. Only set this if Postgres runs in a SEPARATE Docker Compose
# project on the same server (e.g. a shared VPS also running another
# app's database) and DATABASE_URL above uses that project's container
# name as the host (like "postgres" instead of an IP/domain). Docker
# only resolves container-name hostnames between containers on the same
# Docker network, so this tells deploy.sh which network to join.
# Find the name with: docker network ls
# Leave unset if your database is remote (e.g. Neon) or otherwise
# already reachable without sharing a Docker network.
# DB_NETWORK=hrm_default

# NOTE: if you're copying a connection string from a Prisma-based
# project, drop any "?schema=..." query parameter - psycopg does not
# understand it and will refuse to connect. "public" is the default
# schema anyway, so removing it changes nothing.

# Optional. Only set this if port 5000 is already used by something
# else on this server. Changes which HOST port the dashboard/API is
# reachable on - the container's own internal port always stays 5000.
# WEB_PORT=8080
